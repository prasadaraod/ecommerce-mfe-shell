{
  "name": "ecommerce-mfe-shell",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:host": "npm run dev --workspace=apps/host-app",
    "build:products": "npm run build --workspace=apps/products-remote",
    "serve:products": "npm run preview --workspace=apps/products-remote -- --port 5001",
    "build:cart": "npm run build --workspace=apps/cart-remote",
    "serve:cart": "npm run preview --workspace=apps/cart-remote -- --port 5002"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prasadaraod/ecommerce-mfe-shell.git"
  },
  "bugs": {
    "url": "https://github.com/prasadaraod/ecommerce-mfe-shell/issues"
  },
  "homepage": "https://github.com/prasadaraod/ecommerce-mfe-shell#readme"
}